# Demo works without external accounts. Never put service-role secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_SITE_URL=
# demo (default) or public. Public uses only content/public-businesses.json; rebuild required.
NEXT_PUBLIC_CONTENT_MODE=demo
# Planned production integrations (not implemented in the demo):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # server-only; never expose to browser
